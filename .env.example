# ENABLE_GEMINI_AI: Independent server-side feature flag for Gemini AI itinerary generation.
# Set to "true" to activate live Gemini AI generation (gemini-3.8-flash).
# Set to "false" (or leave unset) to use the 100% offline curated Karnataka itinerary generator.
ENABLE_GEMINI_AI="false"

# GEMINI_API_KEY: Server-side Gemini API key (only utilized when ENABLE_GEMINI_AI is "true").
# Kept strictly server-side. Never prefix with VITE_. Never expose in client code.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_GOOGLE_MAPS_API_KEY: Google Maps Platform API Key for maps and places.
VITE_GOOGLE_MAPS_API_KEY="MY_GOOGLE_MAPS_API_KEY"

# SERVER-SIDE EMAIL SERVICE CONFIGURATION (Optional - defaults to internal secure dispatch)
# SMTP Provider (e.g. Gmail App Password, AWS SES, Mailgun, Brevo)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
# Or Resend API Key
RESEND_API_KEY=""
# Private destination email (defaults to private server inbox on backend)
SUPPORT_EMAIL=""
